    <!-- Java Hook Descriptions -->
    <string name="hook_desc_link_properties">Filters LinkProperties serialization to remove VPN interfaces, routes, and DNS servers.</string>
    <string name="hook_desc_network_capabilities">Filters VPN transport out of NetworkCapabilities, cloaking it as Wi-Fi or cellular connections.</string>
    <string name="hook_desc_network_info">Morphs VPN connection status into standard mobile network status (DISCONNECTED or MOBILE) to hide active VPNs.</string>
    <string name="hook_desc_network">Redirects active network requests from the VPN network instance to the best available physical network.</string>
    <string name="hook_desc_connectivity_service">Filters VPN network out of global network lists and blocks leakage of active VPN callbacks.</string>
    <string name="hook_desc_package_manager">Filters VpnServices and hides VPN packages from targeted apps.</string>
    <string name="hook_desc_user_manager">Filters user profiles and spoof isManagedProfile checks to hide work profiles.</string>

