    <!-- Kernel Hook Descriptions -->
    <string name="hook_desc_dev_ioctl">Intercepts general interface IOCTLs (e.g., SIOCGIFFLAGS, SIOCGIFMTU) to hide VPN interface states.</string>
    <string name="hook_desc_sock_ioctl">Intercepts socket-level IOCTLs like SIOCGIFCONF to filter out VPN interfaces during network enumeration.</string>
    <string name="hook_desc_rtnl_fill_ifinfo">Filters VPN network interfaces out of netlink link-dump (RTM_GETLINK) responses.</string>
    <string name="hook_desc_inet6_fill_ifaddr">Filters VPN IPv6 addresses out of netlink address-dump (RTM_GETADDR) responses.</string>
    <string name="hook_desc_inet_fill_ifaddr">Filters VPN IPv4 addresses out of netlink address-dump (RTM_GETADDR) responses.</string>
    <string name="hook_desc_fib_route_seq_show">Filters out VPN routes when apps read the IPv4 routing table in /proc/net/route.</string>
    <string name="hook_desc_ipv6_route_seq_show">Filters out VPN routes when apps read the IPv6 routing table in /proc/net/ipv6_route.</string>
    <string name="hook_desc_fib_dump_info">Filters out IPv4 VPN routes during netlink routing table dumps.</string>
    <string name="hook_desc_fib_nl_fill_rule">Filters out VPN policy routing rules from netlink rule-dump (RTM_GETRULE) responses.</string>
    <string name="hook_desc_rt6_fill_node">Filters out IPv6 VPN routes from netlink route-dump (RTM_GETROUTE) responses.</string>
    <string name="hook_desc_rt_fill_info">Filters out IPv4 VPN routes from netlink route-dump (RTM_GETROUTE) responses.</string>
    <string name="hook_desc_sys_setsockopt">Intercepts setsockopt calls to deny VPN socket binding (SO_BINDTODEVICE/IFINDEX), override SO_MARK to 0, and spoof MTU discovery.</string>
    <string name="hook_desc_sys_getsockopt">Intercepts getsockopt calls to spoof MTU, MSS (TCP_MAXSEG), MTU discovery, and hide socket binding to a VPN interface.</string>
    <string name="hook_desc_sys_connect">Implements Port Hiding by blocking loopback connections to VPN daemon control ports.</string>
    <string name="hook_desc_sys_getsockname_ipv4">Spoofs getsockname for IPv4 sockets, masking the local VPN interface IP with the cover interface IP.</string>
    <string name="hook_desc_sys_getsockname_ipv6">Spoofs getsockname for IPv6 sockets, masking the local VPN interface IP with the cover interface IP.</string>
    <string name="hook_desc_sys_bind">Intercepts bind() on loopback: redirects protected ports to random free ephemeral ports (0) to bypass conflict checks.</string>
    <string name="hook_desc_bpf_stats_spoof">Intercepts BPF map lookups via sys_bpf syscall to return zero traffic counters on stats maps (iface_stats, tether_stats, stats_map_) for VPN interfaces and target UIDs.</string>

